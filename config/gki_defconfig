# =========================================================
#             自定义 GKI 内核配置 Fragment (按功能分类)
# =========================================================

# --- 1. 核心编译与系统响应 (Core & Performance) ---
# 开启 ThinLTO 链接时优化以缩小体积提升性能
CONFIG_LTO_CLANG_THIN=y
# 提升内核系统节拍频率到 300Hz (提高 UI 和触控响应)
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
CONFIG_HZ=300

# --- 2. BPF、探针与内核追踪 (BPF & Tracing) ---
# KernelSU、SUSFS 及各类高级网络监控工具的底层依赖
CONFIG_BPF_EVENTS=y
CONFIG_DEBUG_INFO_BTF_MODULES=y
CONFIG_BPF_STREAM_PARSER=y
CONFIG_KPROBE_EVENTS=y
CONFIG_UPROBES=y
CONFIG_UPROBE_EVENTS=y
CONFIG_TRACEPOINTS=y
CONFIG_FTRACE=y

# --- 3. IO 调度与文件系统 (IO & File Systems) ---
# 开启 Deadline 块设备 IO 调度器
CONFIG_MQ_IOSCHED_DEADLINE=y
# Tmpfs (内存文件系统) 增强特性
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_TMPFS_XATTR=y
CONFIG_TMPFS_INODE64=y
# 微软 NTFS 格式原生支持 (OTG U盘等)
CONFIG_NTFS3_FS=y
CONFIG_NTFS3_LZX_XPRESS=y
CONFIG_NTFS3_FS_POSIX_ACL=y

# --- 4. 高级网络：TCP 拥塞控制与队列 (TCP & Qdisc) ---
# 开启高级 TCP 算法并默认启用 BBR (抗丢包弱网神器)
CONFIG_TCP_CONG_ADVANCED=y
CONFIG_TCP_CONG_BBR=y
CONFIG_TCP_CONG_CUBIC=y
CONFIG_TCP_CONG_WESTWOOD=y
CONFIG_TCP_CONG_HTCP=y
# CONFIG_TCP_CONG_BIC is not set
CONFIG_DEFAULT_BBR=y
# 开启 CAKE 队列调度算法 (缓解路由器缓冲膨胀 Bufferbloat)
CONFIG_NET_SCH_CAKE=y

# --- 5. 高级网络：防校园网/运营商检测 (TTL & HL) ---
# 允许修改数据包的 TTL (IPv4) 和 HL (IPv6) 值，用于热点防检测
CONFIG_NETFILTER_XT_TARGET_HL=y
CONFIG_IP_NF_TARGET_TTL=y
CONFIG_IP6_NF_TARGET_HL=y

# --- 6. 高级网络：IPv6 NAT (热点穿透) ---
# 允许 IPv6 环境下开启网络地址转换 (原生 Android 热点共享 IPv6 必备)
CONFIG_IP6_NF_NAT=y
CONFIG_IP6_NF_TARGET_MASQUERADE=y

# --- 7. 高级网络：IP_SET 与透明代理路由增强 (Proxy & Routing) ---
# Clash / Sing-box 等软路由模块进行底层流量接管和分流的必备基础
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_SET=y
CONFIG_IP_SET=y
CONFIG_IP_SET_MAX=65534
CONFIG_IP_SET_BITMAP_IP=y
CONFIG_IP_SET_BITMAP_IPMAC=y
CONFIG_IP_SET_BITMAP_PORT=y
CONFIG_IP_SET_HASH_IP=y
CONFIG_IP_SET_HASH_IPMARK=y
CONFIG_IP_SET_HASH_IPPORT=y
CONFIG_IP_SET_HASH_IPPORTIP=y
CONFIG_IP_SET_HASH_IPPORTNET=y
CONFIG_IP_SET_HASH_IPMAC=y
CONFIG_IP_SET_HASH_MAC=y
CONFIG_IP_SET_HASH_NETPORTNET=y
CONFIG_IP_SET_HASH_NET=y
CONFIG_IP_SET_HASH_NETNET=y
CONFIG_IP_SET_HASH_NETPORT=y
CONFIG_IP_SET_HASH_NETIFACE=y
CONFIG_IP_SET_LIST_SET=y

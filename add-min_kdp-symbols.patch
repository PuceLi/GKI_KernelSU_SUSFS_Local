 }
+function {
+  id: 0xc18e39fb
+  return_type_id: 0x4585663f
+  parameter_id: 0x3d551c03
+}
 function {
   id: 0xc18f1240
   return_type_id: 0x4585663f
@@ -403638,6 +403643,33 @@ elf_symbol {
   type_id: 0xc59b3a62
   full_name: "lookup_user_key"
 }
+elf_symbol {

+  symbol_type: FUNCTION
+  crc: 0xfb342499
+  type_id: 0x1fcd1693
+  full_name: "kdp_usecount_inc"
+}
 elf_symbol {
   id: 0x493ce9fc
   name: "loops_per_jiffy"
@@ -441632,6 +441664,9 @@ interface {
